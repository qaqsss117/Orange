{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orange:android:update-manifest:v1",
  "title": "Orange signed Android APK update manifest",
  "type": "object",
  "required": ["schemaVersion", "packageName", "versionCode", "versionName", "generatedAtUnix", "expiresAtUnix", "signingCertificateSha256", "apkMirrors", "signatureKeyId", "signature"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "packageName": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*(?:\\.[a-z_][a-z0-9_]*)+$" },
    "versionCode": { "type": "integer", "minimum": 1 },
    "versionName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "generatedAtUnix": { "type": "integer", "minimum": 1 },
    "expiresAtUnix": { "type": "integer", "minimum": 1 },
    "signingCertificateSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "apkMirrors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["url", "sha256", "bytes"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 }
        },
        "additionalProperties": false
      }
    },
    "signatureKeyId": { "$ref": "bootstrap-manifest.schema.json#/$defs/identifier" },
    "signature": { "type": "string", "minLength": 86, "maxLength": 86 }
  },
  "additionalProperties": false
}
