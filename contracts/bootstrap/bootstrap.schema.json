{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orange:bootstrap:plaintext:v1",
  "title": "Orange bootstrap plaintext",
  "type": "object",
  "required": [
    "schemaVersion",
    "configurationVersion",
    "expiresAtUnix",
    "candidates",
    "failover",
    "startupDns",
    "apiHosts"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "configurationVersion": { "type": "integer", "minimum": 1 },
    "expiresAtUnix": { "type": "integer", "minimum": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "failover": { "$ref": "#/$defs/failover" },
    "startupDns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/startupDns" }
    },
    "apiHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[^\\s/?#]+$"
    },
    "candidate": {
      "type": "object",
      "required": ["id", "protocol", "server", "port", "credential"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "protocol": {
          "type": "string",
          "enum": ["trojan", "hysteria2", "shadowsocks"]
        },
        "server": { "$ref": "#/$defs/host" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "credential": { "type": "string", "minLength": 1, "maxLength": 512 },
        "tlsServerName": { "$ref": "#/$defs/host" },
        "shadowsocksMethod": {
          "type": "string",
          "enum": [
            "2022-blake3-aes-128-gcm",
            "2022-blake3-aes-256-gcm",
            "aes-128-gcm",
            "aes-256-gcm",
            "chacha20-ietf-poly1305"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "protocol": { "const": "shadowsocks" } },
            "required": ["protocol"]
          },
          "then": {
            "required": ["shadowsocksMethod"],
            "properties": { "tlsServerName": false }
          },
          "else": {
            "required": ["tlsServerName"],
            "properties": { "shadowsocksMethod": false }
          }
        }
      ],
      "additionalProperties": false
    },
    "failover": {
      "type": "object",
      "required": [
        "connectTimeoutMs",
        "requestTimeoutMs",
        "maxAttempts",
        "backoffBaseMs"
      ],
      "properties": {
        "connectTimeoutMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 8 },
        "backoffBaseMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
      },
      "additionalProperties": false
    },
    "startupDns": {
      "type": "object",
      "required": ["protocol", "server", "port"],
      "properties": {
        "protocol": { "type": "string", "enum": ["udp", "tcp", "tls"] },
        "server": { "$ref": "#/$defs/host" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tlsServerName": { "$ref": "#/$defs/host" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "protocol": { "const": "tls" } },
            "required": ["protocol"]
          },
          "then": { "required": ["tlsServerName"] },
          "else": { "properties": { "tlsServerName": false } }
        }
      ],
      "additionalProperties": false
    }
  }
}
