{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orange:bootstrap:txt-locator:v1",
  "title": "Orange signed TXT bootstrap locator",
  "type": "object",
  "required": ["schemaVersion", "sequence", "generatedAtUnix", "expiresAtUnix", "manifestUrls", "signatureKeyId", "signature"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "generatedAtUnix": { "type": "integer", "minimum": 1 },
    "expiresAtUnix": { "type": "integer", "minimum": 1 },
    "manifestUrls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "signatureKeyId": { "$ref": "bootstrap-manifest.schema.json#/$defs/identifier" },
    "signature": { "type": "string", "minLength": 86, "maxLength": 86 }
  },
  "additionalProperties": false
}
