{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.invalid/contracts/business-api/business-api.schema.v1.json",
  "title": "Orange clean-room business API contract v1",
  "schemaVersion": 1,
  "environment": "development",
  "releaseAllowed": false,
  "unknownFieldPolicy": {
    "objects": "reject",
    "statusValues": "map_to_unknown"
  },
  "units": {
    "timestamp": "unix_milliseconds",
    "money": "integer_minor_units",
    "traffic": "bytes",
    "integerMaximum": 9007199254740991
  },
  "x-orange-operations": [
    {
      "name": "config",
      "request": null,
      "wireResponse": "#/$defs/ConfigWireResponse",
      "publicResponse": "#/$defs/ConfigResponse"
    },
    {
      "name": "login",
      "request": "#/$defs/LoginRequest",
      "wireResponse": "#/$defs/AuthWireResponse",
      "publicResponse": "#/$defs/AuthPublicResponse"
    },
    {
      "name": "emailVerification",
      "request": "#/$defs/SendEmailVerificationRequest",
      "wireResponse": "#/$defs/EmailVerificationResponse",
      "publicResponse": "#/$defs/EmailVerificationResponse"
    },
    {
      "name": "resetPassword",
      "request": "#/$defs/ResetPasswordRequest",
      "wireResponse": "#/$defs/PasswordResetResponse",
      "publicResponse": "#/$defs/PasswordResetResponse"
    },
    {
      "name": "register",
      "request": "#/$defs/RegisterRequest",
      "wireResponse": "#/$defs/AuthWireResponse",
      "publicResponse": "#/$defs/AuthPublicResponse"
    },
    {
      "name": "account",
      "request": null,
      "wireResponse": "#/$defs/AccountResponse",
      "publicResponse": "#/$defs/AccountResponse"
    },
    {
      "name": "subscription",
      "request": null,
      "wireResponse": "#/$defs/SubscriptionWireResponse",
      "publicResponse": "#/$defs/SubscriptionPublicResponse"
    },
    {
      "name": "plans",
      "request": null,
      "wireResponse": "#/$defs/PlansResponse",
      "publicResponse": "#/$defs/PlansResponse"
    },
    {
      "name": "orders",
      "request": "#/$defs/CreateOrderRequest",
      "wireResponse": "#/$defs/OrderResponse",
      "publicResponse": "#/$defs/OrderResponse"
    },
    {
      "name": "payment",
      "request": "#/$defs/CreatePaymentRequest",
      "wireResponse": "#/$defs/PaymentWireResponse",
      "publicResponse": "#/$defs/PaymentPublicResponse"
    },
    {
      "name": "invite",
      "request": null,
      "wireResponse": "#/$defs/InviteResponse",
      "publicResponse": "#/$defs/InviteResponse"
    },
    {
      "name": "tickets",
      "request": "#/$defs/CreateTicketRequest",
      "wireResponse": "#/$defs/TicketsResponse",
      "publicResponse": "#/$defs/TicketsResponse"
    },
    {
      "name": "update",
      "request": null,
      "wireResponse": "#/$defs/UpdateResponse",
      "publicResponse": "#/$defs/UpdateResponse"
    }
  ],
  "$defs": {
    "SchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "SafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "UnixMillis": {
      "$ref": "#/$defs/SafeInteger"
    },
    "CurrencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "Money": {
      "type": "object",
      "required": ["minorUnits", "currency"],
      "properties": {
        "minorUnits": { "$ref": "#/$defs/SafeInteger" },
        "currency": { "$ref": "#/$defs/CurrencyCode" }
      },
      "additionalProperties": false
    },
    "AccountStatus": {
      "type": "string",
      "x-knownValues": ["active", "disabled"],
      "x-unknownValueMapping": "unknown"
    },
    "SubscriptionStatus": {
      "type": "string",
      "x-knownValues": ["none", "trial", "active", "expired", "exhausted"],
      "x-unknownValueMapping": "unknown"
    },
    "OrderStatus": {
      "type": "string",
      "x-knownValues": ["pending", "paid", "cancelled", "closed", "refunded"],
      "x-unknownValueMapping": "unknown"
    },
    "PaymentStatus": {
      "type": "string",
      "x-knownValues": ["unavailable", "pending", "ready", "expired"],
      "x-unknownValueMapping": "unknown"
    },
    "TicketStatus": {
      "type": "string",
      "x-knownValues": ["open", "answered", "closed"],
      "x-unknownValueMapping": "unknown"
    },
    "UserProfile": {
      "type": "object",
      "required": ["userId", "email", "status", "balance"],
      "properties": {
        "userId": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "status": { "$ref": "#/$defs/AccountStatus" },
        "balance": { "$ref": "#/$defs/Money" }
      },
      "additionalProperties": false
    },
    "LoginRequest": {
      "type": "object",
      "required": ["schemaVersion", "email", "password"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3 },
        "password": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        }
      },
      "additionalProperties": false
    },
    "RegisterRequest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "email",
        "password",
        "emailCode",
        "inviteCode"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3 },
        "password": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        },
        "emailCode": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{6}$",
          "x-orange-sensitive": true
        },
        "inviteCode": { "type": ["string", "null"], "x-orange-sensitive": true }
      },
      "additionalProperties": false
    },
    "SendEmailVerificationRequest": {
      "type": "object",
      "required": ["schemaVersion", "email"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 }
      },
      "additionalProperties": false
    },
    "ResetPasswordRequest": {
      "type": "object",
      "required": ["schemaVersion", "email", "password", "emailCode"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "x-orange-sensitive": true
        },
        "emailCode": {
          "type": "string",
          "pattern": "^[0-9]{6}$",
          "x-orange-sensitive": true
        }
      },
      "additionalProperties": false
    },
    "EmailVerificationResponse": {
      "type": "object",
      "required": ["schemaVersion", "sent"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "sent": { "const": true }
      },
      "additionalProperties": false
    },
    "PasswordResetResponse": {
      "type": "object",
      "required": ["schemaVersion", "succeeded"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "succeeded": { "const": true }
      },
      "additionalProperties": false
    },
    "CredentialBundle": {
      "type": "object",
      "required": ["accessToken", "refreshToken", "expiresAtUnixMs"],
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        },
        "refreshToken": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        },
        "expiresAtUnixMs": { "$ref": "#/$defs/UnixMillis" }
      },
      "additionalProperties": false
    },
    "AuthWireResponse": {
      "type": "object",
      "required": ["schemaVersion", "credentials", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "credentials": { "$ref": "#/$defs/CredentialBundle" },
        "user": { "$ref": "#/$defs/UserProfile" }
      },
      "additionalProperties": false
    },
    "AuthPublicResponse": {
      "type": "object",
      "required": ["schemaVersion", "authenticated", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "authenticated": { "type": "boolean" },
        "user": { "$ref": "#/$defs/UserProfile" }
      },
      "additionalProperties": false
    },
    "ConfigWireResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "minimumSupportedVersion",
        "maintenance",
        "notice",
        "registrationRequiresInvite",
        "registrationRequiresEmailVerification",
        "apiBaseUrl",
        "paymentBaseUrl",
        "supportUrl",
        "bannerUrl"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "minimumSupportedVersion": { "type": "string", "minLength": 1 },
        "maintenance": { "type": "boolean" },
        "notice": { "type": ["string", "null"] },
        "registrationRequiresInvite": { "type": "boolean" },
        "registrationRequiresEmailVerification": { "type": "boolean" },
        "apiBaseUrl": { "type": "string", "x-orange-sensitive": true },
        "paymentBaseUrl": { "type": "string", "x-orange-sensitive": true },
        "supportUrl": { "type": "string", "x-orange-sensitive": true },
        "bannerUrl": {
          "type": ["string", "null"],
          "x-orange-sensitive": true
        }
      },
      "additionalProperties": false
    },
    "ConfigResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "minimumSupportedVersion",
        "maintenance",
        "notice",
        "registrationRequiresInvite",
        "registrationRequiresEmailVerification"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "minimumSupportedVersion": { "type": "string", "minLength": 1 },
        "maintenance": { "type": "boolean" },
        "notice": { "type": ["string", "null"] },
        "registrationRequiresInvite": { "type": "boolean" },
        "registrationRequiresEmailVerification": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "AccountResponse": {
      "type": "object",
      "required": ["schemaVersion", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "user": { "$ref": "#/$defs/UserProfile" }
      },
      "additionalProperties": false
    },
    "SubscriptionWireResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "planId",
        "expiresAtUnixMs",
        "usedBytes",
        "totalBytes",
        "subscriptionCredential"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "status": { "$ref": "#/$defs/SubscriptionStatus" },
        "planId": { "type": ["string", "null"] },
        "expiresAtUnixMs": {
          "oneOf": [{ "$ref": "#/$defs/UnixMillis" }, { "type": "null" }]
        },
        "usedBytes": { "$ref": "#/$defs/SafeInteger" },
        "totalBytes": {
          "oneOf": [{ "$ref": "#/$defs/SafeInteger" }, { "type": "null" }]
        },
        "subscriptionCredential": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        }
      },
      "additionalProperties": false
    },
    "SubscriptionPublicResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "planId",
        "expiresAtUnixMs",
        "usedBytes",
        "totalBytes"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "status": { "$ref": "#/$defs/SubscriptionStatus" },
        "planId": { "type": ["string", "null"] },
        "expiresAtUnixMs": {
          "oneOf": [{ "$ref": "#/$defs/UnixMillis" }, { "type": "null" }]
        },
        "usedBytes": { "$ref": "#/$defs/SafeInteger" },
        "totalBytes": {
          "oneOf": [{ "$ref": "#/$defs/SafeInteger" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "Plan": {
      "type": "object",
      "required": [
        "planId",
        "name",
        "descriptionHtml",
        "price",
        "billingPeriodDays",
        "trafficBytes"
      ],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "descriptionHtml": {
          "type": ["string", "null"],
          "maxLength": 65536
        },
        "price": { "$ref": "#/$defs/Money" },
        "billingPeriodDays": { "$ref": "#/$defs/SafeInteger" },
        "trafficBytes": {
          "oneOf": [{ "$ref": "#/$defs/SafeInteger" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "PlansResponse": {
      "type": "object",
      "required": ["schemaVersion", "plans"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "plans": {
          "type": "array",
          "items": { "$ref": "#/$defs/Plan" },
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "CreateOrderRequest": {
      "type": "object",
      "required": ["schemaVersion", "planId"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "planId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Order": {
      "type": "object",
      "required": [
        "orderId",
        "planId",
        "status",
        "amount",
        "createdAtUnixMs",
        "paidAtUnixMs"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        },
        "planId": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/OrderStatus" },
        "amount": { "$ref": "#/$defs/Money" },
        "createdAtUnixMs": { "$ref": "#/$defs/UnixMillis" },
        "paidAtUnixMs": {
          "oneOf": [{ "$ref": "#/$defs/UnixMillis" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "OrderResponse": {
      "type": "object",
      "required": ["schemaVersion", "order"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "order": { "$ref": "#/$defs/Order" }
      },
      "additionalProperties": false
    },
    "CreatePaymentRequest": {
      "type": "object",
      "required": ["schemaVersion", "orderId", "paymentMethod"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "orderId": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        },
        "paymentMethod": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "PaymentWireResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "orderId",
        "status",
        "qrCode",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "orderId": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        },
        "status": { "$ref": "#/$defs/PaymentStatus" },
        "qrCode": {
          "type": ["string", "null"],
          "maxLength": 4096,
          "x-orange-sensitive": true
        },
        "expiresAtUnixMs": {
          "oneOf": [{ "$ref": "#/$defs/UnixMillis" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "PaymentPublicResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "orderId",
        "status",
        "available",
        "qrCode",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "orderId": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/PaymentStatus" },
        "available": { "type": "boolean" },
        "qrCode": { "type": ["string", "null"], "maxLength": 4096 },
        "expiresAtUnixMs": {
          "oneOf": [{ "$ref": "#/$defs/UnixMillis" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "InviteResponse": {
      "type": "object",
      "required": ["schemaVersion", "inviteCode", "invitedUsers", "commission"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "inviteCode": {
          "type": "string",
          "minLength": 1,
          "x-orange-sensitive": true
        },
        "invitedUsers": { "$ref": "#/$defs/SafeInteger" },
        "commission": { "$ref": "#/$defs/Money" }
      },
      "additionalProperties": false
    },
    "CreateTicketRequest": {
      "type": "object",
      "required": ["schemaVersion", "subject", "message"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 10000 }
      },
      "additionalProperties": false
    },
    "Ticket": {
      "type": "object",
      "required": [
        "ticketId",
        "status",
        "subject",
        "lastMessageAtUnixMs",
        "closedAtUnixMs"
      ],
      "properties": {
        "ticketId": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/TicketStatus" },
        "subject": { "type": "string", "minLength": 1 },
        "lastMessageAtUnixMs": { "$ref": "#/$defs/UnixMillis" },
        "closedAtUnixMs": {
          "oneOf": [{ "$ref": "#/$defs/UnixMillis" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "TicketsResponse": {
      "type": "object",
      "required": ["schemaVersion", "tickets"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "tickets": {
          "type": "array",
          "items": { "$ref": "#/$defs/Ticket" },
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "UpdateResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "latestVersion",
        "mandatory",
        "releaseNotes"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "latestVersion": { "type": "string", "minLength": 1 },
        "mandatory": { "type": "boolean" },
        "releaseNotes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
