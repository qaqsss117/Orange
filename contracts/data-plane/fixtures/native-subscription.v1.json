{
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "node-hk",
      "server": "NODE-HK.EXAMPLE.INVALID",
      "server_port": 443,
      "method": "2022-blake3-aes-256-gcm",
      "password": "<redacted:ss-password>"
    },
    {
      "type": "trojan",
      "tag": "node-sg",
      "server": "NODE-SG.EXAMPLE.INVALID",
      "server_port": 443,
      "password": "<redacted:trojan-password>",
      "tls": {
        "enabled": true,
        "server_name": "NODE-SG.EXAMPLE.INVALID",
        "insecure": false
      }
    },
    {
      "type": "hysteria2",
      "tag": "node-us",
      "server": "NODE-US.EXAMPLE.INVALID",
      "server_port": 8443,
      "password": "<redacted:hysteria2-password>",
      "tls": {
        "enabled": true,
        "server_name": "NODE-US.EXAMPLE.INVALID",
        "insecure": false
      }
    },
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": ["node-hk", "node-sg", "node-us"],
      "default": "node-hk"
    }
  ],
  "route": {
    "rules": [
      {
        "domain_suffix": ["EXAMPLE.INVALID"],
        "outbound": "proxy"
      },
      {
        "ip_cidr": ["2001:db8::1234/64"],
        "outbound": "node-hk"
      },
      {
        "protocol": ["dns", "quic"],
        "outbound": "proxy"
      }
    ],
    "final": "proxy"
  }
}
