{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orange native event envelope v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "instanceId",
    "sequence",
    "occurredAtUnixMs",
    "event"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "instanceId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurredAtUnixMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/ControlStateEvent" },
        { "$ref": "#/$defs/DataStateEvent" },
        { "$ref": "#/$defs/TrafficEvent" }
      ]
    }
  },
  "$defs": {
    "ControlStateEvent": {
      "type": "object",
      "required": ["kind", "state"],
      "properties": {
        "kind": { "const": "control_state" },
        "state": {
          "type": "string",
          "enum": [
            "cold",
            "decrypting",
            "starting",
            "ready",
            "degraded",
            "failed",
            "stopping"
          ]
        }
      },
      "additionalProperties": false
    },
    "DataStateEvent": {
      "type": "object",
      "required": ["kind", "state"],
      "properties": {
        "kind": { "const": "data_state" },
        "state": {
          "type": "string",
          "enum": [
            "unconfigured",
            "validating",
            "permission_required",
            "starting",
            "online",
            "stopping",
            "failed",
            "rollback"
          ]
        }
      },
      "additionalProperties": false
    },
    "TrafficEvent": {
      "type": "object",
      "required": ["kind", "sample"],
      "properties": {
        "kind": { "const": "traffic" },
        "sample": {
          "type": "object",
          "required": [
            "uploadBytesTotal",
            "downloadBytesTotal",
            "uploadBytesPerSecond",
            "downloadBytesPerSecond"
          ],
          "properties": {
            "uploadBytesTotal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "downloadBytesTotal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uploadBytesPerSecond": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "downloadBytesPerSecond": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
