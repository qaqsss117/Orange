{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.invalid/contracts/orange-ipc.schema.json",
  "title": "Orange IPC contract",
  "schemaVersion": 2,
  "x-orange-commands": [
    {
      "name": "get_plane_state",
      "request": "#/$defs/PlaneStateRequest",
      "response": "#/$defs/PlaneStateResponse"
    },
    {
      "name": "get_runtime_info",
      "request": "#/$defs/RuntimeInfoRequest",
      "response": "#/$defs/RuntimeInfoResponse"
    },
    {
      "name": "get_data_plane_event_snapshot",
      "request": "#/$defs/DataPlaneEventSnapshotRequest",
      "response": "#/$defs/DataPlaneEventSnapshotResponse"
    },
    {
      "name": "control_data_plane",
      "request": "#/$defs/DataPlaneControlRequest",
      "response": "#/$defs/DataPlaneControlResponse"
    },
    {
      "name": "get_connection_mode",
      "request": "#/$defs/ConnectionModeRequest",
      "response": "#/$defs/ConnectionModeResponse"
    },
    {
      "name": "set_connection_mode",
      "request": "#/$defs/SetConnectionModeRequest",
      "response": "#/$defs/ConnectionModeResponse"
    },
    {
      "name": "initialize_business",
      "request": "#/$defs/InitializeBusinessRequest",
      "response": "#/$defs/BusinessInitializationResponse"
    },
    {
      "name": "login",
      "request": "#/$defs/LoginCommandRequest",
      "response": "#/$defs/AuthPublicResponse"
    },
    {
      "name": "send_email_verification",
      "request": "#/$defs/SendEmailVerificationCommandRequest",
      "response": "#/$defs/EmailVerificationResponse"
    },
    {
      "name": "register",
      "request": "#/$defs/RegisterCommandRequest",
      "response": "#/$defs/AuthPublicResponse"
    },
    {
      "name": "get_auth_session",
      "request": "#/$defs/AuthSessionRequest",
      "response": "#/$defs/AuthSessionResponse"
    },
    {
      "name": "logout",
      "request": "#/$defs/LogoutRequest",
      "response": "#/$defs/AuthSessionResponse"
    },
    {
      "name": "refresh_account",
      "request": "#/$defs/AccountRefreshRequest",
      "response": "#/$defs/AccountResponse"
    },
    {
      "name": "refresh_subscription",
      "request": "#/$defs/SubscriptionRefreshRequest",
      "response": "#/$defs/SubscriptionPublicResponse"
    },
    {
      "name": "get_subscription_snapshot",
      "request": "#/$defs/SubscriptionSnapshotRequest",
      "response": "#/$defs/SubscriptionSnapshotResponse"
    },
    {
      "name": "get_node_catalog",
      "request": "#/$defs/NodeCatalogRequest",
      "response": "#/$defs/NodeCatalogResponse"
    },
    {
      "name": "select_node",
      "request": "#/$defs/SelectNodeRequest",
      "response": "#/$defs/SelectNodeResponse"
    },
    {
      "name": "test_node_delays",
      "request": "#/$defs/NodeDelayTestRequest",
      "response": "#/$defs/NodeDelayTestResponse"
    }
  ],
  "x-orange-error-definitions": [
    {
      "code": "validation",
      "message": "请求参数无效。",
      "retryable": false
    },
    {
      "code": "permission",
      "message": "当前操作未获授权。",
      "retryable": false
    },
    {
      "code": "network",
      "message": "网络请求失败，请稍后重试。",
      "retryable": true
    },
    {
      "code": "bootstrap",
      "message": "安全连接初始化失败。",
      "retryable": true
    },
    {
      "code": "subscription",
      "message": "订阅数据不可用。",
      "retryable": false
    },
    {
      "code": "service",
      "message": "系统服务暂不可用。",
      "retryable": true
    },
    {
      "code": "timeout",
      "message": "操作超时，请重试。",
      "retryable": true
    },
    {
      "code": "cancelled",
      "message": "操作已取消。",
      "retryable": false
    },
    {
      "code": "internal",
      "message": "发生内部错误。",
      "retryable": false
    }
  ],
  "$defs": {
    "SchemaVersion": {
      "type": "integer",
      "const": 2
    },
    "BusinessSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "validation",
        "permission",
        "network",
        "bootstrap",
        "subscription",
        "service",
        "timeout",
        "cancelled",
        "internal"
      ]
    },
    "CommandError": {
      "type": "object",
      "required": ["schemaVersion", "code", "message", "retryable"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "ControlPlaneState": {
      "type": "string",
      "enum": [
        "cold",
        "decrypting",
        "starting",
        "ready",
        "degraded",
        "failed",
        "stopping"
      ]
    },
    "DataPlaneState": {
      "type": "string",
      "enum": [
        "unconfigured",
        "validating",
        "permission_required",
        "starting",
        "online",
        "stopping",
        "failed",
        "rollback"
      ]
    },
    "PlaneStateRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "PlaneStateResponse": {
      "type": "object",
      "required": ["schemaVersion", "controlPlane", "dataPlane"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "controlPlane": { "$ref": "#/$defs/ControlPlaneState" },
        "dataPlane": { "$ref": "#/$defs/DataPlaneState" }
      },
      "additionalProperties": true
    },
    "RuntimeInfoRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "RuntimeInfoResponse": {
      "type": "object",
      "required": ["schemaVersion", "productName", "productVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "productName": { "type": "string", "const": "Orange" },
        "productVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "DataPlaneEventSnapshotRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "DataPlaneEventSnapshotResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "capacity",
        "droppedCount",
        "streamInstanceId",
        "events"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 256 },
        "droppedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "streamInstanceId": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "events": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "observability/event-envelope.schema.v1.json"
          }
        }
      },
      "additionalProperties": false
    },
    "DataPlaneControlAction": {
      "type": "string",
      "enum": ["status", "start", "stop"]
    },
    "DataPlaneControlRequest": {
      "type": "object",
      "required": ["schemaVersion", "action"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "action": { "$ref": "#/$defs/DataPlaneControlAction" }
      },
      "additionalProperties": false
    },
    "DataPlaneControlResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "controlPlane",
        "dataPlane",
        "canStart",
        "canStop"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "controlPlane": { "$ref": "#/$defs/ControlPlaneState" },
        "dataPlane": { "$ref": "#/$defs/DataPlaneState" },
        "canStart": { "type": "boolean" },
        "canStop": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "ConnectionMode": {
      "type": "string",
      "enum": ["system_proxy", "tun"]
    },
    "ConnectionModeRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "SetConnectionModeRequest": {
      "type": "object",
      "required": ["schemaVersion", "mode"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "mode": { "$ref": "#/$defs/ConnectionMode" }
      },
      "additionalProperties": false
    },
    "ConnectionModeResponse": {
      "type": "object",
      "required": ["schemaVersion", "mode"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "mode": { "$ref": "#/$defs/ConnectionMode" }
      },
      "additionalProperties": true
    },
    "InitializeBusinessRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "AuthSessionRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "LogoutRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "AccountRefreshRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "SubscriptionRefreshRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "SubscriptionSnapshotRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "NodeCatalogRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "SelectNodeRequest": {
      "type": "object",
      "required": ["schemaVersion", "selectorId", "nodeId"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "selectorId": { "$ref": "#/$defs/PublicNodeId" },
        "nodeId": { "$ref": "#/$defs/PublicNodeId" }
      },
      "additionalProperties": false
    },
    "NodeDelayTestRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "LoginCommandRequest": {
      "type": "object",
      "required": ["schemaVersion", "email", "password"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "password": { "type": "string", "minLength": 8, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "RegisterCommandRequest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "email",
        "password",
        "emailCode",
        "inviteCode"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "password": { "type": "string", "minLength": 8, "maxLength": 128 },
        "emailCode": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{6}$"
        },
        "inviteCode": { "type": ["string", "null"], "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "SendEmailVerificationCommandRequest": {
      "type": "object",
      "required": ["schemaVersion", "email"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 }
      },
      "additionalProperties": false
    },
    "AccountStatus": {
      "type": "string",
      "enum": ["active", "disabled", "unknown"]
    },
    "Money": {
      "type": "object",
      "required": ["minorUnits", "currency"],
      "properties": {
        "minorUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "additionalProperties": true
    },
    "UserProfile": {
      "type": "object",
      "required": ["userId", "email", "status", "balance"],
      "properties": {
        "userId": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "status": { "$ref": "#/$defs/AccountStatus" },
        "balance": { "$ref": "#/$defs/Money" }
      },
      "additionalProperties": true
    },
    "ConfigResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "minimumSupportedVersion",
        "maintenance",
        "notice",
        "registrationRequiresInvite",
        "registrationRequiresEmailVerification"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/BusinessSchemaVersion" },
        "minimumSupportedVersion": { "type": "string", "minLength": 1 },
        "maintenance": { "type": "boolean" },
        "notice": { "type": ["string", "null"] },
        "registrationRequiresInvite": { "type": "boolean" },
        "registrationRequiresEmailVerification": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "AuthSessionStatus": {
      "type": "string",
      "enum": ["signed_out", "authenticated", "unverified"]
    },
    "AuthSessionResponse": {
      "type": "object",
      "required": ["schemaVersion", "status", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/BusinessSchemaVersion" },
        "status": { "$ref": "#/$defs/AuthSessionStatus" },
        "user": {
          "oneOf": [{ "$ref": "#/$defs/UserProfile" }, { "type": "null" }]
        }
      },
      "additionalProperties": true
    },
    "BusinessInitializationResponse": {
      "type": "object",
      "required": ["schemaVersion", "config", "session"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/BusinessSchemaVersion" },
        "config": { "$ref": "#/$defs/ConfigResponse" },
        "session": { "$ref": "#/$defs/AuthSessionResponse" }
      },
      "additionalProperties": true
    },
    "AuthPublicResponse": {
      "type": "object",
      "required": ["schemaVersion", "authenticated", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/BusinessSchemaVersion" },
        "authenticated": { "type": "boolean" },
        "user": { "$ref": "#/$defs/UserProfile" }
      },
      "additionalProperties": true
    },
    "EmailVerificationResponse": {
      "type": "object",
      "required": ["schemaVersion", "sent"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/BusinessSchemaVersion" },
        "sent": { "const": true }
      },
      "additionalProperties": false
    },
    "AccountResponse": {
      "type": "object",
      "required": ["schemaVersion", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/BusinessSchemaVersion" },
        "user": { "$ref": "#/$defs/UserProfile" }
      },
      "additionalProperties": false
    },
    "SubscriptionStatus": {
      "type": "string",
      "enum": ["none", "trial", "active", "expired", "exhausted", "unknown"]
    },
    "SubscriptionPublicResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "planId",
        "expiresAtUnixMs",
        "usedBytes",
        "totalBytes"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/BusinessSchemaVersion" },
        "status": { "$ref": "#/$defs/SubscriptionStatus" },
        "planId": { "type": ["string", "null"] },
        "expiresAtUnixMs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalBytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "SubscriptionSnapshotResponse": {
      "type": "object",
      "required": ["schemaVersion", "subscription", "localRevision"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "subscription": {
          "oneOf": [
            { "$ref": "#/$defs/SubscriptionPublicResponse" },
            { "type": "null" }
          ]
        },
        "localRevision": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": true
    },
    "PublicNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!orange-)[A-Za-z0-9._-]+$"
    },
    "PublicNodeProtocol": {
      "type": "string",
      "enum": ["shadowsocks", "trojan", "hysteria2", "vless"]
    },
    "PublicNode": {
      "type": "object",
      "required": ["id", "protocol"],
      "properties": {
        "id": { "$ref": "#/$defs/PublicNodeId" },
        "protocol": { "$ref": "#/$defs/PublicNodeProtocol" }
      },
      "additionalProperties": true
    },
    "PublicNodeGroup": {
      "type": "object",
      "required": ["id", "selectedNodeId", "nodes"],
      "properties": {
        "id": { "$ref": "#/$defs/PublicNodeId" },
        "selectedNodeId": { "$ref": "#/$defs/PublicNodeId" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/PublicNode" }
        }
      },
      "additionalProperties": true
    },
    "NodeCatalogResponse": {
      "type": "object",
      "required": ["schemaVersion", "revision", "groups"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "revision": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "groups": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/PublicNodeGroup" }
        }
      },
      "additionalProperties": true
    },
    "SelectNodeResponse": {
      "type": "object",
      "required": ["schemaVersion", "selectorId", "nodeId"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "selectorId": { "$ref": "#/$defs/PublicNodeId" },
        "nodeId": { "$ref": "#/$defs/PublicNodeId" }
      },
      "additionalProperties": true
    },
    "PublicNodeDelay": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "delayMs"],
          "properties": {
            "status": { "const": "available" },
            "delayMs": { "type": "integer", "minimum": 1, "maximum": 60000 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["timed_out", "unavailable"] } },
          "additionalProperties": false
        }
      ]
    },
    "PublicNodeDelayResult": {
      "type": "object",
      "required": ["selectorId", "nodeId", "result"],
      "properties": {
        "selectorId": { "$ref": "#/$defs/PublicNodeId" },
        "nodeId": { "$ref": "#/$defs/PublicNodeId" },
        "result": { "$ref": "#/$defs/PublicNodeDelay" }
      },
      "additionalProperties": true
    },
    "NodeDelayTestResponse": {
      "type": "object",
      "required": ["schemaVersion", "results"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "results": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/PublicNodeDelayResult" }
        }
      },
      "additionalProperties": true
    }
  }
}
