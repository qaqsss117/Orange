{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.invalid/contracts/orange-ipc.schema.json",
  "title": "Orange IPC contract",
  "schemaVersion": 1,
  "x-orange-commands": [
    {
      "name": "get_plane_state",
      "request": "#/$defs/PlaneStateRequest",
      "response": "#/$defs/PlaneStateResponse"
    },
    {
      "name": "get_runtime_info",
      "request": "#/$defs/RuntimeInfoRequest",
      "response": "#/$defs/RuntimeInfoResponse"
    },
    {
      "name": "initialize_business",
      "request": "#/$defs/InitializeBusinessRequest",
      "response": "#/$defs/BusinessInitializationResponse"
    },
    {
      "name": "login",
      "request": "#/$defs/LoginCommandRequest",
      "response": "#/$defs/AuthPublicResponse"
    },
    {
      "name": "register",
      "request": "#/$defs/RegisterCommandRequest",
      "response": "#/$defs/AuthPublicResponse"
    },
    {
      "name": "get_auth_session",
      "request": "#/$defs/AuthSessionRequest",
      "response": "#/$defs/AuthSessionResponse"
    },
    {
      "name": "refresh_account",
      "request": "#/$defs/AccountRefreshRequest",
      "response": "#/$defs/AccountResponse"
    },
    {
      "name": "refresh_subscription",
      "request": "#/$defs/SubscriptionRefreshRequest",
      "response": "#/$defs/SubscriptionPublicResponse"
    }
  ],
  "x-orange-error-definitions": [
    {
      "code": "validation",
      "message": "请求参数无效。",
      "retryable": false
    },
    {
      "code": "permission",
      "message": "当前操作未获授权。",
      "retryable": false
    },
    {
      "code": "network",
      "message": "网络请求失败，请稍后重试。",
      "retryable": true
    },
    {
      "code": "bootstrap",
      "message": "安全连接初始化失败。",
      "retryable": true
    },
    {
      "code": "subscription",
      "message": "订阅数据不可用。",
      "retryable": false
    },
    {
      "code": "service",
      "message": "系统服务暂不可用。",
      "retryable": true
    },
    {
      "code": "timeout",
      "message": "操作超时，请重试。",
      "retryable": true
    },
    {
      "code": "cancelled",
      "message": "操作已取消。",
      "retryable": false
    },
    {
      "code": "internal",
      "message": "发生内部错误。",
      "retryable": false
    }
  ],
  "$defs": {
    "SchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "validation",
        "permission",
        "network",
        "bootstrap",
        "subscription",
        "service",
        "timeout",
        "cancelled",
        "internal"
      ]
    },
    "CommandError": {
      "type": "object",
      "required": ["schemaVersion", "code", "message", "retryable"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "ControlPlaneState": {
      "type": "string",
      "enum": [
        "cold",
        "decrypting",
        "starting",
        "ready",
        "degraded",
        "failed",
        "stopping"
      ]
    },
    "DataPlaneState": {
      "type": "string",
      "enum": [
        "unconfigured",
        "validating",
        "permission_required",
        "starting",
        "online",
        "stopping",
        "failed",
        "rollback"
      ]
    },
    "PlaneStateRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "PlaneStateResponse": {
      "type": "object",
      "required": ["schemaVersion", "controlPlane", "dataPlane"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "controlPlane": { "$ref": "#/$defs/ControlPlaneState" },
        "dataPlane": { "$ref": "#/$defs/DataPlaneState" }
      },
      "additionalProperties": true
    },
    "RuntimeInfoRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "RuntimeInfoResponse": {
      "type": "object",
      "required": ["schemaVersion", "productName", "productVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "productName": { "type": "string", "const": "Orange" },
        "productVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "InitializeBusinessRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "AuthSessionRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "AccountRefreshRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "SubscriptionRefreshRequest": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" }
      },
      "additionalProperties": false
    },
    "LoginCommandRequest": {
      "type": "object",
      "required": ["schemaVersion", "email", "password"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "password": { "type": "string", "minLength": 8, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "RegisterCommandRequest": {
      "type": "object",
      "required": ["schemaVersion", "email", "password", "inviteCode"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "password": { "type": "string", "minLength": 8, "maxLength": 128 },
        "inviteCode": { "type": ["string", "null"], "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "AccountStatus": {
      "type": "string",
      "enum": ["active", "disabled", "unknown"]
    },
    "Money": {
      "type": "object",
      "required": ["minorUnits", "currency"],
      "properties": {
        "minorUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "additionalProperties": true
    },
    "UserProfile": {
      "type": "object",
      "required": ["userId", "email", "status", "balance"],
      "properties": {
        "userId": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "status": { "$ref": "#/$defs/AccountStatus" },
        "balance": { "$ref": "#/$defs/Money" }
      },
      "additionalProperties": true
    },
    "ConfigResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "minimumSupportedVersion",
        "maintenance",
        "notice",
        "registrationRequiresInvite"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "minimumSupportedVersion": { "type": "string", "minLength": 1 },
        "maintenance": { "type": "boolean" },
        "notice": { "type": ["string", "null"] },
        "registrationRequiresInvite": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "AuthSessionStatus": {
      "type": "string",
      "enum": ["signed_out", "authenticated", "unverified"]
    },
    "AuthSessionResponse": {
      "type": "object",
      "required": ["schemaVersion", "status", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "status": { "$ref": "#/$defs/AuthSessionStatus" },
        "user": {
          "oneOf": [{ "$ref": "#/$defs/UserProfile" }, { "type": "null" }]
        }
      },
      "additionalProperties": true
    },
    "BusinessInitializationResponse": {
      "type": "object",
      "required": ["schemaVersion", "config", "session"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "config": { "$ref": "#/$defs/ConfigResponse" },
        "session": { "$ref": "#/$defs/AuthSessionResponse" }
      },
      "additionalProperties": true
    },
    "AuthPublicResponse": {
      "type": "object",
      "required": ["schemaVersion", "authenticated", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "authenticated": { "type": "boolean" },
        "user": { "$ref": "#/$defs/UserProfile" }
      },
      "additionalProperties": true
    },
    "AccountResponse": {
      "type": "object",
      "required": ["schemaVersion", "user"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "user": { "$ref": "#/$defs/UserProfile" }
      },
      "additionalProperties": false
    },
    "SubscriptionStatus": {
      "type": "string",
      "enum": ["none", "trial", "active", "expired", "exhausted", "unknown"]
    },
    "SubscriptionPublicResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "planId",
        "expiresAtUnixMs",
        "usedBytes",
        "totalBytes"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "status": { "$ref": "#/$defs/SubscriptionStatus" },
        "planId": { "type": ["string", "null"] },
        "expiresAtUnixMs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalBytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  }
}
