{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange://contracts/rules/rule-resource-manifest.schema.v1.json",
  "title": "Orange Rule Resource Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "resources"],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "format",
          "format_version",
          "sing_box_version",
          "sha256",
          "size_bytes",
          "source",
          "license",
          "generated_at",
          "expires_at",
          "signature"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.!-]*\\.(?:srs|mmdb)$",
            "maxLength": 96
          },
          "format": { "enum": ["srs", "mmdb"] },
          "format_version": { "type": "integer", "minimum": 1, "maximum": 255 },
          "sing_box_version": { "const": "1.13.14" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "commit", "output_commit"],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "output_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "license": { "type": "string", "minLength": 1, "maxLength": 128 },
          "generated_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "algorithm", "key_id", "value"],
            "properties": {
              "status": {
                "enum": [
                  "unsigned-development-bundle",
                  "verified-release-signature"
                ]
              },
              "algorithm": { "enum": ["none", "ed25519"] },
              "key_id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "value": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    }
  }
}
