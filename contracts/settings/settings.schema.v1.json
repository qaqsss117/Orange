{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orange application settings v1",
  "type": "object",
  "required": ["schemaVersion", "locale", "launchOnStartup"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "locale": { "type": "string", "enum": ["system", "zh-CN", "en-US"] },
    "launchOnStartup": { "type": "boolean" }
  },
  "additionalProperties": false
}
