{
  "name": "orange-vpn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "pnpm check:resources && tsc -b && vite build",
    "build:desktop": "pnpm build && pnpm prepare:desktop",
    "check:frontend": "pnpm format:check && pnpm lint && pnpm build",
    "check:resources": "python scripts/ci/check_resources_manifest.py",
    "android:configure": "python scripts/dev/configure-generated-android.py",
    "android:init": "tauri android init && pnpm android:configure",
    "dev": "vite",
    "dev:desktop": "pnpm prepare:desktop && vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html package.json \"tsconfig*.json\" vite.config.ts eslint.config.js \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html package.json \"tsconfig*.json\" vite.config.ts eslint.config.js \".github/workflows/*.yml\"",
    "lint": "eslint . --max-warnings 0",
    "prepare:desktop": "python scripts/ci/prepare_control_plane_sidecar.py",
    "prepare:windows": "python scripts/ci/prepare_windows_bundle.py",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.12",
    "lucide-react": "1.27.0",
    "marked": "18.0.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/dompurify": "^3.2.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  }
}
