{
  "name": "orange-vpn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "build:desktop": "pnpm build && pnpm prepare:desktop",
    "android:configure": "python scripts/dev/configure-generated-android.py",
    "android:init": "tauri android init && pnpm android:configure",
    "dev": "vite",
    "dev:desktop": "pnpm prepare:desktop && vite",
    "prepare:desktop": "python scripts/ci/prepare_control_plane_sidecar.py",
    "prepare:windows": "python scripts/ci/prepare_windows_bundle.py",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
