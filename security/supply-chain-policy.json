{
  "schema_version": 1,
  "managed_resource_roots": [
    "assets/brand",
    "src-tauri/icons"
  ],
  "managed_build_artifact_roots": [
    "target/debug",
    "src-tauri/gen/android/app/build/outputs"
  ],
  "managed_build_artifact_suffixes": [
    "",
    ".exe",
    ".dll",
    ".dylib",
    ".so",
    ".jar",
    ".aar",
    ".dex",
    ".appex",
    ".xcframework",
    ".srs",
    ".mmdb",
    ".apk",
    ".aab"
  ],
  "allowed_build_artifact_signatures": [
    "unsigned-debug",
    "debug-signature-untrusted",
    "verified-release-signature"
  ],
  "release_eligible_signatures": [
    "verified-release-signature"
  ],
  "dependency_lockfiles": {
    "cargo": "Cargo.lock",
    "npm": "pnpm-lock.yaml",
    "pypi": "scripts/ci/requirements-gitee.txt",
    "go": "native/controlplane/go.sum"
  },
  "required_dependency_ecosystems": [
    "cargo",
    "npm",
    "pypi",
    "go",
    "gradle",
    "swift",
    "rules"
  ],
  "dependency_systems_without_packages": {
    "gradle": "The generated Android shell is excluded from Git; dependencies are regenerated from locked Tauri and Gradle versions.",
    "swift": "The iOS secret-store package uses only the local Tauri Swift API supplied by exact Cargo dependencies; no external Swift package is resolved.",
    "rules": "No SRS or MMDB rule-data dependency is bundled before GEO-G0-001 approves its source and license."
  },
  "locked_build_dependencies": [
    {
      "ecosystem": "pypi",
      "name": "tomli",
      "version": "2.2.1",
      "license": "MIT",
      "sha256": "cb55c73c5f4408779d0cf3eef9f762b9c9f147a77de7b258bef0a5628adc85cc",
      "lockfile": "scripts/ci/requirements-gitee.txt"
    }
  ],
  "denied_dependency_patterns": [
    "(^|[-_./])clash($|[-_./])",
    "(^|[-_./])mihomo($|[-_./])",
    "(^|[-_./])tesseract($|[-_./])",
    "(^|[-_./])paddleocr($|[-_./])",
    "(^|[-_./])bip39($|[-_./])",
    "(^|[-_./])mnemonic($|[-_./])",
    "(^|[-_./])analytics($|[-_./])",
    "(^|[-_./])telemetry($|[-_./])"
  ],
  "approved_build_download_hosts": [
    "registry.npmmirror.com",
    "npmmirror.com",
    "rsproxy.cn",
    "goproxy.cn",
    "sum.golang.google.cn",
    "maven.aliyun.com",
    "mirrors.aliyun.com",
    "mirrors.cloud.tencent.com",
    "mirrors.tuna.tsinghua.edu.cn"
  ],
  "build_configuration_globs": [
    ".cargo/*.toml",
    ".github/workflows/*.yml",
    ".workflow/*.yml",
    ".npmrc",
    "gradle/*.gradle",
    "native/apple/**/Package.swift",
    "scripts/ci/*.py",
    "scripts/ci/*.sh",
    "scripts/ci/*.txt",
    "scripts/dev/check-mirrors.ps1",
    "scripts/dev/*.sh",
    "scripts/dev/setup-mirrors.ps1",
    "toolchains.toml"
  ],
  "non_download_url_prefixes": [
    "http://archive.ubuntu.com/ubuntu/",
    "http://azure.archive.ubuntu.com/ubuntu/",
    "http://security.ubuntu.com/ubuntu/",
    "http://schemas.android.com/"
  ]
}
