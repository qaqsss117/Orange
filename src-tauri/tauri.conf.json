{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "百夫长隐私VPN",
  "version": "1.0.0",
  "identifier": "com.orange.vpn.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "百夫长隐私VPN",
        "width": 1100,
        "height": 720,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://client.crisp.chat; connect-src 'self' ipc: http://ipc.localhost https://*.crisp.chat wss://*.crisp.chat; img-src 'self' asset: http://asset.localhost data: blob: https://*.crisp.chat; style-src 'self' 'unsafe-inline' https://client.crisp.chat; font-src 'self' https://client.crisp.chat; media-src 'self' blob: https://*.crisp.chat; frame-src https://*.crisp.chat; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwOUIzOTk1RDgzMTIwRTQKUldUa0lESFlsVG1ia0JOQ0RJbVFxOHZGcWRvVWFCU1hXMk9OZy95N1R1VzIxK3E1bFdQY2wzQWoK",
      "endpoints": [
        "https://github.com/qaqsss117/Orange/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../docs/licenses/rules/SagerNet-GPL-3.0-or-later.txt": "rules/SagerNet-GPL-3.0-or-later.txt",
      "../resources/rules/resource-manifest.json": "rules/resource-manifest.json",
      "../resources/rules/geoip-cn.srs": "rules/geoip-cn.srs",
      "../resources/rules/geosite-cn.srs": "rules/geosite-cn.srs",
      "../resources/rules/geosite-geolocation-not-cn.srs": "rules/geosite-geolocation-not-cn.srs"
    }
  }
}
